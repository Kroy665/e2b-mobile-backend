# Server
NODE_ENV=development
PORT=2345
LOG_LEVEL=info

# Supabase (Project Settings -> API Keys)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
SUPABASE_SECRET_KEY=sb_secret_your-key
# Project Settings -> API -> JWT Settings (JWKS is used for asymmetric key verification with rotation)
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# CORS: comma-separated list of allowed origins, or "*" for all
CORS_ORIGINS=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Public URL of this API (used to build the GitHub OAuth redirect URI)
APP_URL=http://localhost:2345

# GitHub OAuth App: https://github.com/settings/developers -> New OAuth App
# Authorization callback URL must be: <APP_URL_OF_THIS_API>/api/v1/integrations/github/callback
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_OAUTH_REDIRECT_URI=http://localhost:2345/api/v1/integrations/github/callback

# E2B: https://e2b.dev dashboard -> API Keys
E2B_API_KEY=your-e2b-api-key
# Sandbox template (https://e2b.dev dashboard -> Templates). Defaults to a
# template preloaded with opencode if left unset. Source for the default
# template: ../opencode-template/opencode-sandbox (sibling to this repo).
E2B_TEMPLATE_ID=cice9hn8008bhwbef45h

# 32-byte key, base64-encoded, used to encrypt stored GitHub tokens at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
